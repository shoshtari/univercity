   "source": [
    "\n",
    "def fact(n): \n",
    "    if n == 0 or n == 1: \n",
    "        return 1\n",
    "    return n * fact(n - 1)\n",
    "def C(n, r):\n",
    "    return fact(n) // (fact(r) * fact(n - r))\n",
    "\n",
    "def P(x):\n",
    "    p = 0.7\n",
    "    return C(100, x) * (p ** x) * ((1 - p) ** (100 - x))\n",
    "print(P(72))"
   ]
  }
 ],
