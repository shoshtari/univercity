# Database
DATABASE_URL=sqlite:////tmp/unipick.db

# JWT (nested with __ delimiter)
JWT__ENCRYPT_KEY=your-super-secret-encrypt-key-32-chars-min
JWT__DECRYPT_KEY=your-super-secret-decrypt-key-32-chars-min
JWT__ALGORITHM=HS256
JWT__TTL=86400

# Webserver
WEBSERVER__HOST=0.0.0.0
WEBSERVER__PORT=8000
WEBSERVER__WSGI=flask
WEBSERVER__THREADS=4
WEBSERVER__CONNECTION_LIMIT=100

# Other
BCRYPT_ROUNDS=12
CORS_ORIGINS=["http://localhost:5173"]